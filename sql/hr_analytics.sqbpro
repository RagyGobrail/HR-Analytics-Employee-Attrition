<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="hr_analytics.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="5457"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="employees" custom_title="0" dock_id="1" table="4,9:mainemployees"/><dock_state state="000000ff00000000fd00000001000000020000043c00000344fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000015c00ffffff0000043c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="employees" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="55"/><column index="3" value="140"/><column index="4" value="62"/><column index="5" value="179"/><column index="6" value="117"/><column index="7" value="63"/><column index="8" value="132"/><column index="9" value="106"/><column index="10" value="144"/><column index="11" value="54"/><column index="12" value="71"/><column index="13" value="98"/><column index="14" value="57"/><column index="15" value="202"/><column index="16" value="93"/><column index="17" value="83"/><column index="18" value="95"/><column index="19" value="79"/><column index="20" value="138"/><column index="21" value="62"/><column index="22" value="110"/><column index="23" value="116"/><column index="24" value="143"/><column index="25" value="105"/><column index="26" value="114"/><column index="27" value="135"/><column index="28" value="102"/><column index="29" value="103"/><column index="30" value="118"/><column index="31" value="150"/><column index="32" value="138"/><column index="33" value="63"/><column index="34" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- ==========================================
-- HR ANALYTICS PROJECT
-- Basic SQL Business Analysis
-- ==========================================

-- QUERY 1: Total number of employees
SELECT COUNT(*) AS Total_Employees
FROM employees;


-- QUERY 2: Employees who stayed vs. left
SELECT
    Attrition,
    COUNT(*) AS Employee_Count
FROM employees
GROUP BY Attrition;


-- QUERY 3: Overall attrition rate
SELECT
    COUNT(*) AS Total_Employees,
    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        AS Employees_Left,
    ROUND(
        100.0 * SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        / COUNT(*),
        2
    ) AS Attrition_Rate
FROM employees;


-- QUERY 4: Attrition by department
SELECT
    Department,
    COUNT(*) AS Total_Employees,
    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        AS Employees_Left,
    ROUND(
        100.0 * SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        / COUNT(*),
        2
    ) AS Attrition_Rate
FROM employees
GROUP BY Department
ORDER BY Attrition_Rate DESC;


-- QUERY 5: Average monthly income by attrition
SELECT
    Attrition,
    ROUND(AVG(MonthlyIncome), 2) AS Average_Monthly_Income
FROM employees
GROUP BY Attrition;


-- QUERY 6: Attrition by job role
SELECT
    JobRole,
    COUNT(*) AS Total_Employees,
    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        AS Employees_Left,
    ROUND(
        100.0 * SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        / COUNT(*),
        2
    ) AS Attrition_Rate
FROM employees
GROUP BY JobRole
ORDER BY Attrition_Rate DESC;


-- QUERY 7: Attrition by overtime
SELECT
    OverTime,
    COUNT(*) AS Total_Employees,
    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        AS Employees_Left,
    ROUND(
        100.0 * SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        / COUNT(*),
        2
    ) AS Attrition_Rate
FROM employees
GROUP BY OverTime
ORDER BY Attrition_Rate DESC;


-- QUERY 8: Attrition by age group
SELECT
    CASE
        WHEN Age BETWEEN 18 AND 25 THEN '18-25'
        WHEN Age BETWEEN 26 AND 35 THEN '26-35'
        WHEN Age BETWEEN 36 AND 45 THEN '36-45'
        WHEN Age BETWEEN 46 AND 55 THEN '46-55'
        ELSE '56+'
    END AS Age_Group,
    COUNT(*) AS Total_Employees,
    SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        AS Employees_Left,
    ROUND(
        100.0 * SUM(CASE WHEN Attrition = 'Yes' THEN 1 ELSE 0 END)
        / COUNT(*),
        2
    ) AS Attrition_Rate
FROM employees
GROUP BY Age_Group
ORDER BY MIN(Age);</sql><current_tab id="0"/></tab_sql></sqlb_project>
